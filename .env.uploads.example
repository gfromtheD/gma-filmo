# Copy to an ignored local file. Never insert secrets in this example.
UPLOAD_ENGINE_V2=false
NEXT_PUBLIC_UPLOAD_ENGINE_V2=false
UPLOADS_PAUSED=false
VIDEO_PROVIDER=r2
VIDEO_PROCESSING_ENABLED=false
STREAM_PROVIDER_ENABLED=false
UPLOAD_ENVIRONMENT=staging
UPLOAD_PRODUCTION_READY=false
UPLOAD_ISOLATION_ACK=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
CLOUDFLARE_ACCOUNT_ID=
# Separate private bucket; do not change visibility of historical gma-media.
UPLOAD_R2_PRIVATE_BUCKET=gma-filmo-staging-private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
UPLOAD_EXECUTOR_SECRET=
VIDEO_WORK_DIR=/work/gma-video
VIDEO_SANDBOX=bubblewrap
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
MEDIA_PYTHON_PATH=/usr/bin/python3
# Optional future managed-provider adapter only.
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-580903d2b97f4b4e8810af8c9432d80a.r2.dev
UPLOAD_PREFLIGHT_PROVIDERS=false
# New provider selection is independent from the legacy Cloudflare settings.
MEDIA_VIDEO_PROVIDER=r2
MEDIA_AUXILIARY_PROVIDER=r2
MEDIA_MOCK_ENABLED=false
MEDIA_GATEWAY_URL=
MEDIA_P2P_ENABLED=false
PEERTUBE_PROVIDER_ENABLED=false

# Neutral release: independent legacy write gate, no implicit reopening on rollback
LEGACY_MEDIA_WRITES_ENABLED=false
# Optional extra exact legacy playback hostnames, comma separated (no wildcards)
LEGACY_MEDIA_ALLOWED_HOSTS=
# PEM content, backend only; generate with scripts/media/generate-local-keys.ts
MEDIA_CAPABILITY_PRIVATE_KEY=
MEDIA_CAPABILITY_PUBLIC_KEY=
MEDIA_CAPABILITY_KEY_ID=local-1
