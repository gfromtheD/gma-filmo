# Safe local fixture template. local-stack creates the private .env.media.local from LOCAL status.
UPLOAD_ENVIRONMENT=local
UPLOAD_ISOLATION_ACK=true
MEDIA_LOCAL_PROJECT_ID=gma-filmo-media-local
MEDIA_LOCAL_ISOLATED=true
UPLOAD_ENGINE_V2=true
NEXT_PUBLIC_UPLOAD_ENGINE_V2=true
MEDIA_VIDEO_PROVIDER=mock
MEDIA_AUXILIARY_PROVIDER=mock
MEDIA_MOCK_ENABLED=true
MEDIA_MOCK_STORAGE_DIR=work/media-local/storage
MEDIA_GATEWAY_URL=http://127.0.0.1:4319
MEDIA_P2P_ENABLED=false
PEERTUBE_PROVIDER_ENABLED=false
STREAM_PROVIDER_ENABLED=false
VIDEO_PROCESSING_ENABLED=false
LEGACY_MEDIA_WRITES_ENABLED=false
SUPABASE_URL=http://127.0.0.1:54341
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
SUPABASE_DB_URL=postgresql://postgres:LOCAL_PASSWORD@127.0.0.1:54342/postgres
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
MEDIA_CAPABILITY_KEY_ID=local-1
MEDIA_CAPABILITY_PRIVATE_KEY_FILE=work/media-local/keys/private.pem
MEDIA_CAPABILITY_PUBLIC_KEY_FILE=work/media-local/keys/public.pem
# Filled only by the isolated local runner. Never use production credentials here.
MEDIA_LOCAL_TEST_PASSWORD=
UPLOAD_EXECUTOR_SECRET=
