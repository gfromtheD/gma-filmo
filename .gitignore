# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# archive (local only, never commit)
../_archive

# Local tooling
.claude/
.wrangler/
supabase/.temp/

.vercel
.env*.local

# Satoshi: la licencia (ITF FFL) prohíbe redistribuir los archivos de la fuente en repositorios públicos
app/fonts/satoshi/*.woff2

# playwright
/test-results/
/playwright-report/
# Local media signing keys (never commit)
/work/media-local/keys/
# Isolated local media runtime (credentials, generated migrations, spool and logs)
/work/media-local/
!.env.media.example
# Private isolated rollback copies and dedicated visual-test build cache
/work/media-rollback/
/.next-responsive/
.next-player/
.next-support/
