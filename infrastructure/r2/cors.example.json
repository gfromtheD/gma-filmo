{
  "CORSRules": [{
    "AllowedOrigins": ["http://localhost:3000", "https://YOUR-STAGING-DOMAIN"],
    "AllowedMethods": ["PUT", "GET", "HEAD"],
    "AllowedHeaders": ["content-type", "content-md5", "range"],
    "ExposeHeaders": ["ETag", "Content-Length", "Content-Range", "Accept-Ranges"],
    "MaxAgeSeconds": 300
  }]
}
