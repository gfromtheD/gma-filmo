# Future-only template; requires a reviewed deployment artifact and private env.
[Unit]
Description=GMA media gateway
After=network-online.target
[Service]
User=gma-media
Group=gma-media
WorkingDirectory=/srv/gma/current
EnvironmentFile=/etc/gma/media.env
ExecStart=/usr/bin/node --import tsx scripts/media/gateway.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/gma/media-spool
UMask=0077
[Install]
WantedBy=multi-user.target
