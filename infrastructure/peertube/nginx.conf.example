# Replace domains/certificate paths in VPS PHASE. Public GMA gateway, not PeerTube UI.
server {
  listen 80;
  server_name video.example.invalid;
  return 301 https://$host$request_uri;
}
server {
  listen 443 ssl;
  server_name video.example.invalid;
  ssl_certificate /etc/letsencrypt/live/video.example.invalid/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/video.example.invalid/privkey.pem;
  # Do not log query strings: playback capabilities are bearer credentials.
  access_log off;
  client_max_body_size 8m;
  location ~ ^/(transfer|playback|aux)/ {
    proxy_pass http://127.0.0.1:4319;
    proxy_http_version 1.1;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 60s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
  }
  location / { return 404; }
}
# PeerTube :9000, PostgreSQL :5432 and Redis :6379 remain loopback-only.
# CORS and Range are implemented by GMA gateway; do not add wildcard CORS here.
